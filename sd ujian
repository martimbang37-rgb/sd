<title>Generator Soal + Kunci Jawaban untuk Guru SD</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#eaf0f7;--panel:#fff;--ink:#14213d;--mute:#56627a;--line:#cfd9e8;--accent:#2457d6;--accent-ink:#fff;--mark:#ffe45e;--paper:#fff;--rule:#dbe5f3;--margin:#f2a7a7;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1624;--panel:#18223a;--ink:#e8edf7;--mute:#9aa8c4;--line:#2c3a5a;--accent:#7aa2ff;--accent-ink:#0b1430;--mark:#ffe45e;--paper:#1c2742;--rule:#2a3858;--margin:#8f4a4a}}
:root[data-theme="dark"]{--bg:#0f1624;--panel:#18223a;--ink:#e8edf7;--mute:#9aa8c4;--line:#2c3a5a;--accent:#7aa2ff;--accent-ink:#0b1430;--mark:#ffe45e;--paper:#1c2742;--rule:#2a3858;--margin:#8f4a4a}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Lexend",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.5}
.wrap{max-width:1080px;margin:0 auto;padding:20px 16px 48px}
h1{font-size:1.6rem;line-height:1.2;margin:0 0 4px}
.sub{color:var(--mute);margin:0 0 20px}
.note{background:var(--mark);color:#14213d;border-radius:8px;padding:8px 12px;font-size:.85rem;margin-bottom:20px}
.grid{display:grid;grid-template-columns:300px 1fr;gap:20px;align-items:start}
@media (max-width:820px){.grid{grid-template-columns:1fr}}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px}
label{display:block;font-weight:600;font-size:.9rem;margin:12px 0 4px}
label:first-child{margin-top:0}
select,input{width:100%;padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);font:inherit}
button{font:inherit;font-weight:600;border:0;border-radius:8px;padding:12px 16px;cursor:pointer;width:100%}
button:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.go{background:var(--accent);color:var(--accent-ink);margin-top:18px;font-size:1.05rem}
.alt{background:transparent;color:var(--accent);border:2px solid var(--accent);margin-top:10px}
.sheet{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:28px 28px 28px 56px;margin-bottom:20px;position:relative;
background-image:repeating-linear-gradient(transparent 0 31px,var(--rule) 31px 32px);background-position:0 12px}
.sheet::before{content:"";position:absolute;left:40px;top:0;bottom:0;width:2px;background:var(--margin)}
.sheet h2{margin:0 0 4px;font-size:1.2rem;background:var(--paper);display:inline-block;padding-right:8px}
.sheet .nama{margin:0 0 16px;color:var(--mute);font-size:.85rem;background:var(--paper);display:inline-block;padding-right:8px}
.sheet ol.soal{margin:0;padding-left:22px}
.sheet ol.soal>li{margin-bottom:14px}
.q,.opt li{outline:none}
.q:focus,.opt li:focus{background:var(--mark);color:#14213d}
ol.opt{list-style:upper-alpha;margin:4px 0 0;padding-left:26px}
.kunci{columns:2;column-gap:32px;margin:0;padding-left:22px}
.kunci li{margin-bottom:6px;break-inside:avoid}
.empty{border:2px dashed var(--line);border-radius:12px;padding:40px 20px;text-align:center;color:var(--mute)}
.warn{color:var(--mute);font-size:.85rem;margin:0 0 12px}
.hint{font-size:.8rem;color:var(--mute);margin:10px 0 0}
@media print{
body{background:#fff;color:#000}.no-print{display:none!important}.wrap{padding:0;max-width:none}
.grid{display:block}.sheet{border:0;background:#fff;padding:0 0 0 20px;margin:0}.sheet::before{display:none}
.sheet h2,.sheet .nama{background:none;color:#000}.q:focus,.opt li:focus{background:none}
#kunci{break-before:page}}
.akses{margin-top:16px;padding-top:14px;border-top:1px dashed var(--line)}
.status{font-weight:600;font-size:.9rem;margin:0 0 8px}
.beli{display:block;margin-top:10px;text-align:center;font-weight:600;color:var(--accent-ink);background:var(--accent);padding:12px;border-radius:8px;text-decoration:none}
@media print{.akses{display:none}}
#cover{position:fixed;inset:0;z-index:50;background:#14213d;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:max(16px,env(safe-area-inset-top,0px)) 16px max(16px,env(safe-area-inset-bottom,0px))}
#cover img{width:min(92vw,68vh,640px);height:auto;border-radius:16px;box-shadow:0 12px 40px rgba(0,0,0,.45)}
#cover button{width:min(92vw,420px);background:#ffe45e;color:#14213d;font-size:1.1rem}
#cover[hidden]{display:none}
@media print{#cover{display:none!important}}
</style>
</head>
<body>
<div id="cover" class="no-print"><img src="data:image/jpeg;base64," alt="Generator Soal + Kunci Jawaban untuk Guru SD"><button id="masuk">Masuk ke aplikasi</button></div>
<div class="wrap">
<div class="no-print">
<h1>Generator Soal + Kunci Jawaban</h1>
<p class="sub">Pilih kelas, mapel, dan topik. Klik satu tombol, soal dan kunci jawaban langsung jadi.</p>
<div class="note">Periksa kembali soal sebelum dicetak. Soal dibuat otomatis dan bisa diedit langsung di layar.</div>
</div>
<div class="grid">
<div class="panel no-print">
<label for="kelas">Kelas</label>
<select id="kelas"><option>1</option><option>2</option><option>3</option><option selected>4</option><option>5</option><option>6</option></select>
<label for="mapel">Mata pelajaran</label>
<select id="mapel"><option>Matematika</option><option>Bahasa Indonesia</option><option>IPAS</option><option>Pendidikan Pancasila</option><option>Bahasa Inggris</option><option>PJOK</option><option>Seni dan Budaya</option><option>Pendidikan Agama dan Budi Pekerti</option><option>Bahasa Daerah</option></select>
<label for="topik">Topik</label>
<input id="topik" list="saran" placeholder="Pilih saran atau ketik sendiri" autocomplete="off"><datalist id="saran"></datalist><p class="hint" style="margin:4px 0 0">Kosongkan untuk materi umum sesuai kelas.</p>
<label for="jumlah">Jumlah soal</label>
<select id="jumlah"><option value="5">5</option><option value="10" selected>10</option><option value="20">20</option><option value="30">30</option><option value="40">40</option><option value="50">50</option></select>
<label for="jenis">Jenis soal</label>
<select id="jenis"><option value="pg">Pilihan ganda</option><option value="isian">Isian singkat</option></select>
<button class="go" id="buat">Buat soal</button>
<button class="alt" id="ulang" hidden>Buat ulang</button>
<button class="alt" id="cetak" hidden>Cetak / Simpan PDF</button>
<p class="hint" id="hint" hidden>Klik teks soal untuk mengeditnya sebelum dicetak.</p>
<div class="akses"><p class="status" id="status"></p>
<div id="bukabox"><label for="kode">Punya kode akses?</label><input id="kode" placeholder="Contoh: GSOAL-XXXX-XXXX" autocomplete="off"><button class="alt" id="buka">Buka sampai 50 soal</button><a id="beli" class="beli" hidden target="_blank" rel="noopener">Beli kode akses Rp29.000 via WhatsApp</a><p class="hint" id="pesan"></p></div></div>
</div>
<div id="hasil">
<div class="empty no-print">Hasilnya akan muncul di sini. Pilih pengaturan di samping, lalu klik <b>Buat soal</b>.</div>
</div>
</div>
</div>
<script>
const $=id=>document.getElementById(id);
const R=(a,b)=>Math.floor(Math.random()*(b-a+1))+a;
const shuffle=a=>{a=a.slice();for(let i=a.length-1;i>0;i--){const j=R(0,i);[a[i],a[j]]=[a[j],a[i]]}return a};
const f=x=>x.toLocaleString("id-ID");
const SARAN={"Matematika":["Penjumlahan","Pengurangan","Perkalian","Pembagian","Pecahan","Bangun Datar","Pengukuran"],"Bahasa Indonesia":["Teks Narasi","Kata Baku","Sinonim dan Antonim","Ejaan"],"IPAS":["Makhluk Hidup","Siklus Air","Tata Surya","Energi"],"Pendidikan Pancasila":["Sila Pancasila","Norma","Hak dan Kewajiban"],"Bahasa Inggris":["Colors","Numbers","Family","Daily Activities"],"PJOK":["Permainan Bola Besar","Kebugaran Jasmani"],"Seni dan Budaya":["Seni Rupa","Seni Musik","Seni Tari"]};
const OPS=["penjumlahan","pengurangan","perkalian","pembagian"];
const RANGE={1:20,2:100,3:1000,4:10000,5:100000,6:1000000};
const MUL={1:[9,9],2:[9,10],3:[9,12],4:[12,25],5:[25,99],6:[99,99]};
function numOpts(ans){const s=new Set([ans]);const step=Math.max(1,Math.pow(10,String(ans).length-2));let t=0;
while(s.size<4&&t++<100){const v=ans+R(-9,9)*step;if(v>0)s.add(v)}
let n=1;while(s.size<4)s.add(ans+n++);return shuffle([...s])}
function genMath(topik,k,n){const out=[],seen=new Set();let t=0;const max=RANGE[k],m=MUL[k];
while(out.length<n&&t++<800){let a,b,ans,sym;
if(topik==="Penjumlahan"){a=R(1,max-1);b=R(1,max-a);ans=a+b;sym="+"}
else if(topik==="Pengurangan"){a=R(2,max);b=R(1,a-1);ans=a-b;sym="\u2212"}
else if(topik==="Perkalian"){a=R(1,m[0]);b=R(1,m[1]);ans=a*b;sym="\u00d7"}
else{b=R(2,m[0]);const hasil=R(2,m[1]);a=b*hasil;ans=hasil;sym=":"}
const q=f(a)+" "+sym+" "+f(b)+" = ...";
if(seen.has(q)&&t<500)continue;seen.add(q);
const nums=numOpts(ans);
out.push({q,opts:nums.map(f),ansIdx:nums.indexOf(ans),ansText:f(ans)})}
return out}
const esc=x=>String(x).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
async function genAIBatch(mapel,topik,k,n,pg,hindari){
const sample=await claude.use("sample");
if(!sample)throw {code:"none"};
const materi=topik?("topik "+topik):("materi umum sesuai Kurikulum Merdeka kelas "+k);
const fmt=pg?'[{"q":"pertanyaan ...","opts":["jawaban benar","pengecoh 1","pengecoh 2","pengecoh 3"]}]':'[{"q":"kalimat dengan bagian kosong yang ditulis ...","ans":"jawaban singkat"}]';
const prompt="Buat "+n+" soal "+(pg?"pilihan ganda (4 pilihan, tepat satu benar)":"isian singkat")+" untuk siswa SD kelas "+k+", mata pelajaran "+mapel+", "+materi+". Gunakan bahasa Indonesia yang sederhana dan sesuai usia (kecuali mapel bahasa asing). Soal harus akurat, berbeda satu sama lain, dan tidak ambigu."+(hindari?" Hindari soal-soal ini: "+hindari+".":"")+" Pada pilihan ganda, taruh jawaban benar SELALU di opts[0]. Balas HANYA dengan JSON array tanpa teks lain dan tanpa markdown, dengan bentuk: "+fmt;
let v=await sample.json(prompt,{cache:false});
if(!Array.isArray(v))v=v&&(v.soal||v.items||v.questions);
if(!Array.isArray(v))throw {code:"format"};
return v.slice(0,n).filter(e=>e&&e.q).map(e=>{
if(pg){const o=(e.opts||[]).map(String);if(o.length<2)return null;const opts=shuffle(o);return{q:String(e.q),opts,ansIdx:opts.indexOf(o[0]),ansText:o[0]}}
return{q:String(e.q),opts:[],ansIdx:0,ansText:String(e.ans||"")}}).filter(Boolean)}
async function genAI(mapel,topik,k,n,pg,progres){
let hasil=[];
for(let i=0;i<4&&hasil.length<n;i++){
const m=Math.min(25,n-hasil.length);
if(progres)progres(hasil.length,n);
let got;
try{got=await genAIBatch(mapel,topik,k,m,pg,hasil.map(e=>e.q.slice(0,50)).join(" | "))}catch(e){if(hasil.length)break;throw e}
if(!got.length)break;
hasil=hasil.concat(got)}
return hasil}
function isi(){$("saran").innerHTML=(SARAN[$("mapel").value]||[]).map(x=>"<option value='"+x+"'>").join("")}
let sibuk=false;
async function buat(){
if(sibuk)return;
const k=+$("kelas").value,mapel=$("mapel").value,topik=$("topik").value.trim(),n=Math.min(+$("jumlah").value,premium?50:10),pg=$("jenis").value==="pg";
const lokal=mapel==="Matematika"&&OPS.includes(topik.toLowerCase());
const tombol=$("buat");let items;
sibuk=true;tombol.disabled=true;tombol.textContent="Sedang membuat soal...";
try{
items=lokal?genMath(topik[0].toUpperCase()+topik.slice(1).toLowerCase(),k,n):await genAI(mapel,topik,k,n,pg,(a,b)=>{tombol.textContent="Membuat soal "+(a+1)+"\u2013"+Math.min(a+25,b)+" dari "+b+"..."})
}catch(e){
const pesan=e&&e.code==="not_granted"?"Izin ditolak. Klik Buat soal lagi lalu pilih Izinkan.":e&&e.code==="rate_limited"?"Terlalu banyak permintaan. Tunggu sebentar lalu coba lagi.":e&&e.code==="none"?"Pembuatan soal otomatis belum tersedia di tampilan ini. Buka halaman ini langsung dari tautan artifact.":"Soal belum berhasil dibuat. Coba klik Buat soal sekali lagi.";
$("hasil").innerHTML="<div class='empty no-print'>"+pesan+"</div>";
sibuk=false;tombol.disabled=false;tombol.textContent="Buat soal";return}
sibuk=false;tombol.disabled=false;tombol.textContent="Buat soal";
if(!items.length){$("hasil").innerHTML="<div class='empty no-print'>Soal belum berhasil dibuat. Coba klik Buat soal sekali lagi.</div>";return}
const blank=s=>pg?s:s.replace("...","__________");
const judul="Soal "+mapel+(topik?" \u2013 "+topik:"")+" (Kelas "+k+")";
const soal=items.map(it=>"<li><div class='q' contenteditable='true'>"+esc(blank(it.q))+"</div>"+(pg?"<ol class='opt'>"+it.opts.map(o=>"<li contenteditable='true'>"+esc(o)+"</li>").join("")+"</ol>":"")+"</li>").join("");
const kunci=items.map(it=>"<li contenteditable='true'>"+esc((pg?"ABCDEF"[it.ansIdx]+". ":"")+it.ansText)+"</li>").join("");
let info="";if(!premium)info="<p class='warn no-print'>Versi gratis menampilkan maksimal 10 soal. Masukkan kode akses untuk membuka sampai 50 soal.</p>";if(items.length<n)info+="<p class='warn no-print'>Hanya "+items.length+" soal yang berhasil dibuat. Klik Buat ulang untuk mencoba lagi.</p>";
$("hasil").innerHTML=info+"<section class='sheet' id='lembar'><h2>"+esc(judul)+"</h2><p class='nama'>Nama: ____________________ &nbsp; Tanggal: ____________</p><ol class='soal'>"+soal+"</ol></section><section class='sheet' id='kunci'><h2>Kunci Jawaban</h2><p class='nama'>"+esc(judul)+"</p><ol class='kunci'>"+kunci+"</ol></section>";
$("ulang").hidden=false;$("cetak").hidden=false;$("hint").hidden=false}
$("mapel").addEventListener("change",isi);
$("buat").addEventListener("click",buat);
$("ulang").addEventListener("click",buat);
$("cetak").addEventListener("click",()=>{try{window.print()}catch(e){alert("Gunakan menu Cetak di browser (Ctrl+P) lalu pilih Simpan sebagai PDF.")}});
